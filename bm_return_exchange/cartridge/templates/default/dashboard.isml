<iscontent type="text/html" charset="UTF-8" compact="true" />

<isdecorate template="application/MenuFrame">
    <iscomment> Global JS Variables for the Dashboard </iscomment>
    <script>
        // Use window.initialItems to store the data for the default tab on load
        window.initialItems = <isprint value="${JSON.stringify(pdict.items)}" encoding="off" />;
        window.dashboardUrl = "${URLUtils.url('ReturnDashboard-Show')}";
        window.acceptRequestUrl = "${URLUtils.url('ReturnDashboard-AcceptRequest')}";
        window.rejectRequestUrl = "${URLUtils.url('ReturnDashboard-RejectRequest')}";
        window.processRefundUrl = "${URLUtils.url('ReturnDashboard-RefundLineItem')}";
        window.downloadCsvUrl = "${URLUtils.url('ReturnDashboard-DownloadCSV')}";
        
        // Store initial state configuration
        window.initialConfig = {
            isReturn: ${pdict.isReturn},
            tabStatus: "${pdict.tabStatus}"
        };
    </script>

    <iscomment> External Resources </iscomment>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"
        integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <iscomment> Client-side logic should be included AFTER the global variables </iscomment>
    <script src="${URLUtils.staticURL('/js/returnExchange.js')}"></script>

    <div class="py-4">
        <h1 class="bm-title h3 mb-4 pb-2 border-bottom text-dark">Return & Exchange Management</h1>

        <iscomment> Module Selector </iscomment>
        <div class="module-nav card p-3 mb-4 bg-body-tertiary border">
            <div class="d-flex align-items-center">
                <label class="fw-bold text-secondary me-3 mb-0">Select Module:</label>
                <button id="btn-mod-return" class="nav-btn btn btn-outline-primary ${pdict.isReturn ? 'active' : ''}"
                    data-module="Return">Return Management</button>
                <button id="btn-mod-exchange"
                    class="nav-btn btn btn-outline-primary mx-2 ${!pdict.isReturn ? 'active' : ''}"
                    data-module="Exchange">Exchange Management</button>
            </div>
        </div>

        <iscomment> Tabs Navigation </iscomment>
        <div class="tab-container nav nav-tabs mb-4">
            <div class="tab nav-link ${pdict.tabStatus === 'requested' ? 'active' : ''}" data-status="requested"
                role="button">Requested</div>
            <div class="tab nav-link ${pdict.tabStatus === 'approved' ? 'active' : ''}" data-status="approved"
                role="button">Approved</div>
            <div class="tab nav-link ${pdict.tabStatus === 'rejected' ? 'active' : ''}" data-status="rejected"
                role="button">Rejected</div>
            <div class="tab nav-link ${pdict.tabStatus === 'returned' ? 'active' : ''}" id="tab-dynamic"
                data-status="${pdict.isReturn ? 'returned' : 'exchanged'}" role="button">
                <isif condition="${pdict.isReturn}">Returned
                <iselse/>Exchanged</isif>
            </div>
        </div>

        <iscomment> Filter Bar </iscomment>
        <div class="filter-bar d-flex flex-wrap align-items-center gap-3 p-3 bg-body-tertiary border rounded mb-4">
            <span class="fw-bold">List View Filter:</span>
            <div class="d-flex align-items-center gap-2">
                <label class="mb-0">From:</label>
                <input type="date" value="${pdict.startDate}" name="fromDate" id="fromDate"
                    class="form-control form-control-sm" style="width: auto;" />
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="mb-0">To:</label>
                <input type="date" value="${pdict.endDate}" name="toDate" id="toDate"
                    class="form-control form-control-sm" style="width: auto;" />
            </div>

            <iscomment> Added ID for the Apply button to ensure JS listener picks it up </iscomment>
            <button id="btn-apply-filter" class="btn-bm btn btn-sm btn-light border">Apply</button>

            <div class="col-auto ms-auto">
                <button id="btn-download-csv" class="btn btn-outline-success btn-sm px-3">
                    <i class="fa fa-download"></i> Download CSV
                </button>
            </div>
            <iscomment> <button id="btn-back-list"
                    class="btn-bm hidden btn btn-sm btn-outline-secondary ms-auto d-none">&larr; Back to List</button>
            </iscomment>
        </div>

        <iscomment> Modular Table View </iscomment>
        <div id="list-view">
            <isinclude template="return/returnTable" />
        </div>

        <iscomment> Modular Detail View </iscomment>
        <div id="detail-view" class="hidden card shadow-sm d-none">
            <iscomment>
                <isinclude template="return/returnDetail" />
            </iscomment>
            <div id="container-return-detail">
                <isinclude template="return/returnDetail" />
            </div>

            <div id="container-exchange-detail" class="d-none">
                <isinclude template="exchange/exchangeDetail" />
            </div>
        </div>
    </div>
</isdecorate>