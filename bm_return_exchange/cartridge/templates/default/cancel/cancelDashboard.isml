<iscontent type="text/html" charset="UTF-8" compact="true" />

<isdecorate template="application/MenuFrame">
    <iscomment> Global JS Variables for the Cancellation Dashboard </iscomment>
    <script>
        window.initialItems = <isprint value="${JSON.stringify(pdict.items)}" encoding="off" />;
        window.dashboardUrl = "${URLUtils.url('CancelDashboard-Show')}";
        window.processRefundUrl = "${URLUtils.url('CancelDashboard-RefundCancelledItem')}";
        window.downloadCsvUrl = "${URLUtils.url('CancelDashboard-DownloadCSV')}";   
        window.initialConfig = {
            tabStatus: "${pdict.tabStatus}"
        };
    </script>
    
    <iscomment> External Resources </iscomment>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <iscomment> Dedicated logic for Cancellation </iscomment>
    <script src="${URLUtils.staticURL('/js/cancelDashboard.js')}"></script>

    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <h1 class="h3 mb-0 text-dark">Order Cancellation Management</h1> 
        </div>

        <iscomment> Tabs Navigation: Simplified to two tabs </iscomment>
        <ul class="nav nav-tabs mb-4" id="cancel-tabs">
            <li class="nav-item">
                <button class="nav-link tab ${pdict.tabStatus === 'cancelled' ? 'active' : ''}" data-status="cancelled">
                    Cancelled (Pending Refund)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link tab ${pdict.tabStatus === 'refunded' ? 'active' : ''}" data-status="refunded">
                    Cancelled & Refunded
                </button>
            </li>
        </ul>

        <iscomment> Filter Bar </iscomment>
        <div id="filter-section" class="card p-3 bg-light border rounded mb-4 shadow-sm">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <span class="fw-bold"><i class="fa fa-filter"></i> Filters:</span>
                </div>
                <div class="col-auto d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">From:</label>
                    <input type="date" value="${pdict.startDate}" id="fromDate" class="form-control form-control-sm w-auto" />
                </div>
                <div class="col-auto d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">To:</label>
                    <input type="date" value="${pdict.endDate}" id="toDate" class="form-control form-control-sm w-auto" />
                </div>
                <div class="col-auto">
                    <button id="btn-apply-filter" class="btn btn-primary btn-sm px-4">Apply Filter</button>
                </div>
                <iscomment> Add this inside your filter-bar section </iscomment>
                <div class="col-auto ms-auto">
                    <button id="btn-download-cancel-csv" class="btn btn-outline-success btn-sm px-3">
                        <i class="fa fa-download"></i> Download CSV
                    </button>
                </div>
            </div>
        </div>

        <iscomment> List View Container </iscomment>
        <div id="list-view">
            <isinclude template="cancel/cancelTable" />
        </div>

        <iscomment> Detail View Container </iscomment>
        <div id="detail-view" class="card shadow-sm d-none">
            <isinclude template="cancel/cancelDetail" />
        </div>
    </div>
</isdecorate>