<iscontent type="text/html" charset="UTF-8" compact="true" />
<iscomment> Detail Header </iscomment>
<div class="detail-header card-header d-flex justify-content-between align-items-center bg-white py-3">
    <div>
        <h2 class="h5 mb-1">Request Details: <span id="det-order" class="text-primary">ORD-XXXXXX</span></h2>
        <div class="small text-muted">
            <iscomment> Status: <span id="det-status" class="status-badge badge rounded-pill bg-secondary"></span>
            </iscomment>
            Requested on: <strong id="det-requested-date">00-00-0000</strong> |
            Delivered on: <strong id="det-delivered-date">00-00-0000</strong>
        </div>
    </div>
    <button class="btn-bm btn btn-sm btn-outline-secondary" id="btn-close-detail">X Close</button>
</div>

<iscomment> Detail Body </iscomment>
<div class="detail-grid card-body">
    <div class="row g-4">
        <div class="col-lg-8 col-md-7">
            <iscomment> Item View (Return) </iscomment>
            <div id="return-item-view">
                <h6 class="text-uppercase text-secondary fw-bold border-bottom pb-2 mb-3">Item Details</h6>
                <div class="d-flex bg-light p-3 border rounded">
                    <div id="item-info-container">
                        <div class="d-flex align-items-center">
                            <div class='detail-info-image'>
                                <img id="detail-info-img" src='ImageUrl' alt='Dummy Image'
                                    class='img-thumbnail rounded p-0' style='width: 80px; height: 80px;' />
                            </div>
                            <div class='detail-info-text mx-2'>
                                <strong class="d-block mb-2" id="det-item-name">Running Shoes - Red (Size 10)</strong>
                                <div class="small">
                                    Price: <span id="det-item-price">150.00</span><br />
                                    Quantity: <span id="det-item-qty">1</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <iscomment> Exchange Comparison View </iscomment>
            <div id="exchange-item-view" class="hidden d-none">
                <h6 class="text-uppercase text-secondary fw-bold border-bottom pb-2 mb-3">Exchange Details</h6>
                <div
                    class="exchange-comparison d-flex align-items-center justify-content-between bg-primary-subtle p-3 border border-primary border-dashed rounded">
                    <div class="exchange-card bg-white p-2 border rounded text-center shadow-sm" style="width: 45%;">
                        <div class="small text-muted text-uppercase mb-1">Original Item</div>
                        <strong class="d-block" id="ex-orig-name">Blue Shirt (L)</strong>
                        <span id="ex-orig-price">$45.00</span>
                    </div>
                    <div class="fs-4 text-secondary">&rarr;</div>
                    <div class="exchange-card bg-white p-2 border rounded text-center shadow-sm" style="width: 45%;">
                        <div class="small text-primary text-uppercase mb-1">Exchange For</div>
                        <strong class="d-block" id="ex-new-name">Blue Shirt (XL)</strong>
                        <span id="ex-new-price">$45.00</span>
                    </div>
                </div>
            </div>

            <iscomment> Reason & Media </iscomment>
            <h6 class="text-uppercase text-secondary fw-bold border-bottom pb-2 mb-3 mt-4">Reason & Media</h6>
            <div class="mb-2 row">
                <div class="col-sm-3 fw-bold text-secondary">Reason:</div>
                <div class="col-sm-9" id="det-reason">Size too small</div>
            </div>
            <div class="mb-2 row">
                <div class="col-sm-3 fw-bold text-secondary">Description:</div>
                <div class="col-sm-9 fst-italic" id="det-desc">"The shoes fit too tight on the toes."</div>
            </div>
            <div class="mb-2 row">
                <div class="col-sm-3 fw-bold text-secondary">Uploads:</div>
                <div class="col-sm-9">
                    <div id="det-media-tiles" class="d-flex flex-wrap gap-2">
                        <iscomment>Tiles will be injected here via JS</iscomment>
                    </div>
                </div>
            </div>
            <div class="row mb-2 small border-top pt-2 mt-2">
                <div class="col-sm-3 fw-bold text-secondary ">Inventory Status:</div>
                <div class="col-sm-9"><span id="det-inventory-status"
                        class="badge bg-secondary-subtle text-secondary border">--</span></div>
            </div>
        </div>

        <iscomment> Customer Info Sidebar </iscomment>
        <div class="col-lg-4 col-md-5">
            <div class="bg-light p-3 rounded border h-100">
                <h6 class="text-uppercase text-secondary fw-bold border-bottom pb-2 mb-3">Customer Details</h6>
                <div class="mb-2"><span class="d-block fw-bold text-secondary small">Name:</span> <span
                        id="det-cust-name">John Doe</span></div>
                <div class="mb-2"><span class="d-block fw-bold text-secondary small">Email:</span> <span
                        id="det-cust-email" class="text-break">john.doe@example.com</span></div>
                <div class="mb-2"><span class="d-block fw-bold text-secondary small">Phone:</span> <span
                        id="det-cust-phone">+1 555 0199 223</span></div>
                <div class="mb-4"><span class="d-block fw-bold text-secondary small">Address:</span> <span
                        id="det-cust-addr">123 Fashion St, NY 10001</span></div>
                <iscomment>
                    <h6 class="text-uppercase text-secondary fw-bold border-bottom pb-2 mb-3">Refund</h6>
                </iscomment>
                <div class="small mb-2 border-top pt-2">
                    <span class="fw-bold text-secondary">Payment Method:</span>
                    <span class="" id="det-payment-method">--</span>
                </div>
                <iscomment>
                    <div class="mt-2 text-dark fw-bold">Total to Refund: <span id="det-total-refund">150.00</span></div>
                </iscomment>

                <iscomment> Refund Processing Section (Visible only in 'returned' tab) </iscomment>
                <div id="refund-processing-section" class="mt-3 p-3 border rounded bg-white d-none">
                    <h6 class="text-uppercase text-primary fw-bold border-bottom pb-2 mb-3 small">Process Refund</h6>

                    <iscomment> State: Already Refunded </iscomment>
                    <div id="refund-already-processed" class="alert alert-success d-none">
                        <i class="fa fa-check-circle"></i> Amount Refunded Successfully.
                    </div>

                    <iscomment> State: Pending Refund </iscomment>
                    <div id="refund-form-container">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Refund Amount</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <isprint
                                        value="${pdict.items && pdict.items.length > 0 ? pdict.items[0].currencySymbol : '$'}" />
                                </span>
                                <input type="number" id="input-refund-amount" class="form-control" step="0.01"
                                    value="" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Refund Method</label>
                            <select id="select-refund-method" class="form-select form-select-sm">
                                <option value="">Select Method...</option>
                                <isif
                                    condition="${pdict.allowedPaymentMethods && pdict.allowedPaymentMethods.length > 0}">
                                    <isloop items="${pdict.allowedPaymentMethods}" var="method">
                                        <option value="${method.value}">${method.name}</option>
                                    </isloop>
                                </isif>
                            </select>
                        </div>

                        <iscomment> Bank Details Display: Only shown if BANK_TRANSFER is selected </iscomment>
                        <div id="bank-details-container" class="mt-3 mb-3 p-2 border rounded bg-white d-none"
                            style="font-size: 0.85rem;">
                            <div class="fw-bold text-secondary border-bottom mb-2 pb-1">Customer Bank Info</div>
                            <div class="mb-1"><strong>Bank:</strong> <span id="det-bank-name"></span></div>
                            <div class="mb-1"><strong>Acc No:</strong> <span id="det-bank-acc"></span></div>
                            <div class="mb-1"><strong>IFSC:</strong> <span id="det-bank-ifsc"></span></div>
                            <div class="mb-1"><strong>Mobile:</strong> <span id="det-bank-mobile"></span></div>
                        </div>

                        <button id="btn-process-refund" class="btn btn-success btn-sm w-100">Process Refund</button>
                    </div>
                </div>

                <iscomment> Standard Total Display (for other tabs) </iscomment>
                <div id="standard-total-display" class="mt-2 text-dark fw-bold">
                    Total to Refund: <span id="det-total-refund">0.00</span>
                </div>

                <iscomment> Rejection Reason Section </iscomment>
                <div id="rejection-reason-container" class="mt-3 d-none">

                    <iscomment> Shown only in Requested Tab </iscomment>
                    <div id="rejection-input-block" class="d-none border-top pt-2">
                        <label class="form-label small fw-bold text-muted">Reason for Rejection:</label>
                        <textarea id="return-reject-reason-input" class="form-control form-control-sm p-2" rows="2"
                            placeholder="Enter the reason if you are rejecting this request..."></textarea>
                    </div>

                    <iscomment> Shown only in Rejected Tab </iscomment>
                    <div id="rejection-display-block" class="d-none">
                        <div class="p-2 border rounded bg-danger-subtle text-danger small">
                            <strong>Reason:</strong> <span id="det-rejection-reason-text"></span>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<iscomment> Detail Action Footer </iscomment>
<div id="action-buttons"
    class="action-bar hidden card-footer bg-white border-top-0 d-flex justify-content-end align-items-center gap-2 pt-3 pb-3 d-none">
    <span class="fst-italic text-muted small me-auto">* Action required for this request</span>
    <button id="btn-reject" class="btn-bm btn btn-danger">Reject Request</button>
    <button id="btn-approve" class="btn-bm btn btn-primary">Approve Request</button>
</div>